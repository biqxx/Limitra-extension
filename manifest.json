{
  "manifest_version": 3,
  "name": "Limitra Product Sourcer",
  "version": "1.0.0",
  "description": "Add products, full pricing details, and variations from Amazon, eBay, Walmart, and more into Limitra AI Review & Storefront.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.ebay.com/*",
    "https://*.ebay.co.uk/*",
    "https://*.walmart.com/*",
    "https://api.limitra.com.ng/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Limitra Product Sourcer"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.ebay.com/*",
        "https://*.ebay.co.uk/*",
        "https://*.walmart.com/*"
      ],
      "js": [
        "src/adapters/utils.js",
        "src/adapters/amazon.js",
        "src/adapters/ebay.js",
        "src/adapters/walmart.js",
        "src/adapters/registry.js",
        "src/content/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

